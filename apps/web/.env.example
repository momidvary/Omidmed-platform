# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). NEVER commit .env.local or real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (service role). Required ONLY for the AI
# ticket auto-reply route; keep it out of the browser and out of git.
SUPABASE_SECRET_KEY=

# Optional: force local demo mode with no auth and no database.
# Allowed values: mock | (empty for real Supabase mode)
NEXT_PUBLIC_DATA_MODE=
