# Copy to .env.local for development. Configure the same names in the
# deployment platform for preview/production. Never commit real values.

# Data mode. Set `mock` only for an explicit local/demo environment.
# Leave empty (or use any non-mock value) for Supabase mode. Production with
# missing Supabase public variables fails closed instead of becoming a demo.
NEXT_PUBLIC_DATA_MODE=

# Browser-safe Supabase project configuration (Project Settings -> API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret/service-role key. Required by guarded server
# routes for ticket acknowledgements and audited clinical AI. Never prefix it
# with NEXT_PUBLIC_, expose it to the browser, or commit it.
SUPABASE_SECRET_KEY=

# Durable clinical-alert delivery. Vercel Cron calls the internal worker using
# CRON_SECRET. The worker signs a metadata-only webhook with the second secret.
# Use random values of at least 32 bytes and an approved public HTTPS endpoint.
CRON_SECRET=
CLINICAL_ALERT_WEBHOOK_URL=
CLINICAL_ALERT_WEBHOOK_SECRET=

# Internal fixed-output posture UI sandbox. It does not analyse image pixels.
# Keep false in any clinical or production deployment.
NEXT_PUBLIC_ENABLE_POSTURE_SANDBOX=false

# Audited clinical AI requires BOTH client and server gates to be true.
# Keep all gates false until data-processing approval and deployment review.
NEXT_PUBLIC_ENABLE_CLINICAL_AI_DRAFTS=false
ENABLE_CLINICAL_AI_DRAFTS=false
OPENAI_CLINICAL_DATA_PROCESSING_APPROVED=false

# Server-only OpenAI configuration. Leave blank while clinical AI is disabled.
OPENAI_API_KEY=
OPENAI_MODEL=

# Atomic server-side quota limits. Blank values use conservative defaults
# (5/minute, 40/user/day, 500/clinic/day). Invalid values fail closed.
CLINICAL_AI_PER_MINUTE_LIMIT=
CLINICAL_AI_DAILY_USER_LIMIT=
CLINICAL_AI_DAILY_CLINIC_LIMIT=
