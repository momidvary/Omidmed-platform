# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). NEVER commit .env.local or real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: force local demo mode with no auth and no database.
# Allowed values: mock | (empty for real Supabase mode)
NEXT_PUBLIC_DATA_MODE=
