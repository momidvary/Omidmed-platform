# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). NEVER commit .env.local or real keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (service role): used ONLY by server route
# handlers (AI ticket reply, account provisioning, phone recovery).
# Never expose in the browser, never commit.
SUPABASE_SECRET_KEY=

# Optional: Cloudflare Turnstile CAPTCHA site key (public, not secret).
# Enable captcha in Supabase → Auth → Attack protection with the matching
# Turnstile SECRET key set there (not here).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Kavenegar SMS keys are NOT set here: they live in Supabase Secrets for
# the send-auth-sms Edge Function (see docs/KAVENEGAR_SETUP_FA.md).

# Optional: force local demo mode with no auth and no database.
# Allowed values: mock | (empty for real Supabase mode)
NEXT_PUBLIC_DATA_MODE=
